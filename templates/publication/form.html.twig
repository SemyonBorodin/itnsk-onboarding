{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ck-editor__editable_inline {
            min-height: 14rem;
        }
    </style>
{% endblock %}

{% block body %}
    {# обернули в card и назначили полям классы Silicon. #}
    <section class="container pb-5">
        <div class="card card-body mx-auto" style="max-width: 48rem;">
            <span class="badge bg-primary align-self-start mb-3">Редактор</span>
            <h1 class="h2">{{ title }}</h1>

            {{ form_start(form, {
                attr: {novalidate: 'novalidate'}
            }) }}
                {# form_row рисует label, ошибки и input #}
                {{ form_row(form.title, {
                    label: 'Название',
                    attr: {class: 'form-control'}
                }) }}
                {{ form_row(form.slug, {
                    label: 'Slug',
                    attr: {class: 'form-control'}
                }) }}
                {{ form_row(form.content, {
                    label: 'Содержание',
                    attr: {class: 'form-control js-ckeditor', rows: 10}
                }) }}
                {{ form_row(form.category, {
                    label: 'Категория',
                    attr: {class: 'form-select'}
                }) }}
                {{ form_row(form.publishedAt, {
                    label: 'Дата публикации',
                    attr: {class: 'form-control'}
                }) }}

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">Сохранить</button>
                    <a class="btn btn-outline-primary" href="{{ path('app_home') }}">Отмена: На главную</a>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
        class PublicationImageUploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }

            upload() {
                return this.loader.file.then((file) => new Promise((resolve, reject) => {
                    const data = new FormData();
                    data.append('upload', file);

                    fetch('{{ path('app_publication_image_upload') }}', {
                        method: 'POST',
                        body: data
                    })
                        .then((response) => response.json())
                        .then((response) => {
                            if (response.error) {
                                reject(response.error.message);

                                return;
                            }

                            resolve({
                                default: response.url
                            });
                        })
                        .catch(() => {
                            reject('Не удалось загрузить изображение.');
                        });
                }));
            }
        }

        function publicationImageUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
                return new PublicationImageUploadAdapter(loader);
            };
        }

        document.querySelectorAll('.js-ckeditor').forEach((element) => {
            ClassicEditor
                .create(element, {
                    extraPlugins: [publicationImageUploadAdapterPlugin],
                    toolbar: [
                        'undo',
                        'redo',
                        '|',
                        'bold',
                        'italic',
                        '|',
                        'imageUpload'
                    ],
                    image: {
                        toolbar: [
                            'imageTextAlternative',
                            'toggleImageCaption',
                            'imageStyle:inline',
                            'imageStyle:block',
                            'imageStyle:side'
                        ]
                    }
                })
                .then((editor) => {
                    element.closest('form')?.addEventListener('submit', () => {
                        editor.updateSourceElement();
                    });
                })
                .catch((error) => {
                    console.error(error);
                });
        });
    </script>
{% endblock %}
