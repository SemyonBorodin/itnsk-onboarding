{% extends 'base.html.twig' %}

{% block title %}Категория: {{ category.name }}{% endblock %}

{% block body %}
    <section class="content-section">
        <div class="container">
            <h1 class="mb-4">Категория: {{ category.name }}</h1>

            <div class="row">
                <div class="col-xl-9 col-lg-8">
                    {% for publication in publications %}
                        <article class="card me-xl-5 mb-4">
                            <div class="card-body">
                                <h2 class="h4">
                                    <a href="{{ path('app_publication_show', {
                                        id: publication.id
                                    }) }}">
                                        {{ publication.title }}
                                    </a>
                                </h2>

                                {% set content = publication.content|striptags %}

                                <p class="mb-4">
                                    {{ content|slice(0, 220) }}
                                    {% if content|length > 220 %}...{% endif %}
                                </p>

                                <div class="text-muted fs-sm mb-3">
                                    {{ publication.createdAt|date('d.m.Y') }}
                                </div>

                                <a
                                    class="btn btn-primary"
                                    href="{{ path('app_publication_show', {
                                        id: publication.id
                                    }) }}"
                                >
                                    Читать
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="alert alert-info">
                            В этой категории пока нет публикаций.
                        </div>
                    {% endfor %}
                </div>

                <aside class="col-xl-3 col-lg-4">
                    {% include 'publication/_sidebar.html.twig' with {
                        sidebar_publications: sidebar_publications
                    } only %}
                </aside>
            </div>
        </div>
    </section>
{% endblock %}
