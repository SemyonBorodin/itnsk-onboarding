<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Блог{% endblock %}</title>
    <meta name="description" content="{% block description %}Блог{% endblock %}">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('silicon/css/theme.min.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="{{ asset('silicon/favicon/apple-touch-icon.png') }}"
    >
    <link
        rel="icon"
        type="image/png"
        sizes="32x32"
        href="{{ asset('silicon/favicon/favicon-32x32.png') }}"
    >
    <link
        rel="icon"
        type="image/png"
        sizes="16x16"
        href="{{ asset('silicon/favicon/favicon-16x16.png') }}"
    >
    <link
        rel="manifest"
        href="{{ asset('silicon/favicon/site.webmanifest') }}"
    >
    <link
        rel="mask-icon"
        href="{{ asset('silicon/favicon/safari-pinned-tab.svg') }}"
        color="#6366f1"
    >
    <link
        rel="shortcut icon"
        href="{{ asset('silicon/favicon/favicon.ico') }}"
    >
    <meta name="msapplication-TileColor" content="#080032">
    <meta
        name="msapplication-config"
        content="{{ asset('silicon/favicon/browserconfig.xml') }}"
    >
    <meta name="theme-color" content="#ffffff">

</head>
<body>
<header class="header navbar navbar-expand-lg bg-light shadow-sm shadow-dark-mode-none fixed-top">
    <div class="container px-3">
        <a class="navbar-brand pe-3" href="{{ path('app_home') }}">
            Блог
        </a>

        {# Это как я понял для мобильного меню, заработает после подключения theme.min.js. #}
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Открыть меню"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <nav class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">
                        Публикации
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_about') }}">
                        О блоге
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-3">
                {% if app.user %}
                    <a
                        class="btn btn-primary"
                        href="{{ path('app_publication_create') }}"
                    >
                        Создать публикацию
                    </a>

                    <span>{{ app.user.userIdentifier }}</span>

                    <a class="nav-link" href="{{ path('app_logout') }}">
                        Выйти
                    </a>
                {% else %}
                    <a class="btn btn-outline-primary" href="{{ path('app_login') }}">
                        Войти
                    </a>
                {% endif %}
            </div>
        </nav>
    </div>
</header>

<main class="page-wrapper">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="footer bg-dark pt-5 pb-4 pb-lg-5" data-bs-theme="dark">
    <div class="container pt-lg-4">
        <div class="navbar-brand text-dark p-0 me-0 mb-3 mb-lg-4">
            Блог
        </div>

        <p class="nav d-block fs-xs text-center text-md-start pb-5 pb-lg-0 mb-0">
              <span class="text-light opacity-50"> &copy; {{ 'now'|date('Y') }} Блог
              </span>
        </p>
    </div>
</footer>

{% block javascripts %}
{% endblock %}
</body>
</html>
